{
  "name": "@littlevoid/eggshell",
  "version": "0.1.3",
  "description": "CLI that owns the Electron process for kiosk installations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlevoid-io/eggshell.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eggshell": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "ui/dashboard"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:ui",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:ui": "npm run build -w ui/dashboard",
    "dev:ui": "npm run dev -w ui/dashboard",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "release": "node scripts/release.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "deepmerge": "^4.3.1",
    "detect-port": "^2.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "env-paths": "^4.0.0",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "fkill": "^10.0.3",
    "meow": "^14.1.0",
    "p-retry": "^8.0.1",
    "p-timeout": "^7.0.2",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "read-pkg": "^10.1.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.13",
    "wait-on": "^9.1.0",
    "write-json-file": "^7.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/wait-on": "^5.3.4",
    "eslint": "^10.10.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
