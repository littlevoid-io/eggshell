{
  "name": "eggshell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/dashboard": {
      "types": "./dist/plugins/dashboard/index.d.ts",
      "import": "./dist/plugins/dashboard/index.js"
    },
    "./plugins/offline": {
      "types": "./dist/plugins/offline/index.d.ts",
      "import": "./dist/plugins/offline/index.js"
    },
    "./plugins/companion": {
      "types": "./dist/plugins/companion/index.d.ts",
      "import": "./dist/plugins/companion/index.js"
    },
    "./plugins/soak": {
      "types": "./dist/plugins/soak/index.d.ts",
      "import": "./dist/plugins/soak/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.4"
  },
  "peerDependencies": {
    "electron": ">=44.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "electron": "^44.3.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
